# Copy to .env and fill in the key only if you turn the cloud paraphrase on.
# .env is gitignored. Do not put a real key in this example.

# Cloud answers for open questions. Leave the key empty to keep replies local.
# Even when enabled, the learner must explicitly consent by voice in each session.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
COACH_LLM=false

# Screenshots of unlabeled controls stay on this machine unless this is true.
COACH_VISION=false
COACH_VISION_MODEL=gpt-5.6-luna
COACH_VISION_DETAIL=low
COACH_VISION_TIMEOUT_SECONDS=3
# focus reads each newly focused control; quiet reads only the lesson target.
COACH_SPEECH_POLICY=focus
# adaptive fades instructional speech per skill; accessibility support remains.
COACH_ASSISTANCE_LEVEL=adaptive
# off by default on third-party sites. target_only repairs only an exact,
# reviewed lesson target and never clicks it.
COACH_KEYBOARD_REPAIR=off

# true uses the local mic in coach/.venv312: Silero, Smart Turn, PhoWhisper, ZeroTTS.
# false opens the sandbox. Arrows and Enter stay on the page.
COACH_MIC=false

# true lets the mic cut the coach off. Leave false on laptop speakers, because
# the microphone hears the coach and would cancel the sentence.
COACH_BARGE_IN=false

# Show the browser so a person can move the pointer.
COACH_HEADED=true

# auto speaks with edge-tts when it is installed, and logs that the sentence left.
# print = terminal only. zerotts = local, recorded as staying on the machine.
# edge = Vietnamese neural voice via Microsoft, always logged as leaving.
COACH_TTS=auto
COACH_EDGE_VOICE=vi-VN-HoaiMyNeural

COACH_WHISPER_MODEL=vudang449/PhoWhisper-small-ct2
COACH_WHISPER_LANGUAGE=vi
COACH_WHISPER_DEVICE=gpu
COACH_WHISPER_COMPUTE_TYPE=int8
COACH_ZEROTTS_MODEL=zeroweight-ai/ZeroTTS
COACH_ZEROTTS_VOICE=maichi
COACH_ZEROTTS_CACHE_DIR=.cache/zerotts

COACH_SANDBOX_PORT=8765
COACH_CUE_POLL_SECONDS=0.10
# MacBook microphones usually need a much lower VAD volume threshold than the
# Pipecat default of 0.6.
COACH_VAD_MIN_VOLUME=0.002
COACH_EGRESS_LOG=logs/egress.jsonl
COACH_BROWSER_AUDIT_LOG=logs/browser-audit.jsonl
COACH_LATENCY_LOG=logs/latency.jsonl
COACH_PROGRESS_FILE=state/progress.json

# Real web (default remains the local sandbox). Prefer the Companion button,
# which chooses a random CDP port and closes its Chrome process with the app.
# A manual port must be explicit and match COACH_CDP_URL for that run.
COACH_START_URL=https://supabase.com/dashboard
COACH_CDP_URL=
COACH_ALLOWED_ORIGINS=
COACH_TARGET_TAB_TITLE=
# native_focus lets Tab and the screen reader own navigation. coach_list only
# injects arrow navigation after the learner explicitly says "đi nút".
COACH_NAV_MODE=native_focus
COACH_INJECT_NAVIGATION=false
# Reviewed JSON manifest: quoted labels and deterministic completion probes.
COACH_TARGET_MANIFEST=
# The approved onboarding PDF for the attached web flow. Empty uses the demo.
COACH_LESSON_PDF=
# Optional path to the locally installed agent-browser binary. It is read-only:
# coach invokes only `snapshot -i --json`.
COACH_AGENT_BROWSER_BIN=
